<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- USB keyboards are spoken to directly (UsbMidiDirect); tablets without USB host still install. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application>
        <!-- The app as a MIDI device for other MIDI apps: see SharedMidiDevice. -->
        <service
            android:name="org.lilyengine.midi.SharedMidiDevice"
            android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.media.midi.MidiDeviceService" />
            </intent-filter>
            <meta-data
                android:name="android.media.midi.MidiDeviceService"
                android:resource="@xml/lilypond_midi_device" />
        </service>
    </application>
</manifest>
