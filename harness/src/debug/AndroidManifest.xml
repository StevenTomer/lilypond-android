<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: a stand-in for a USB MIDI keyboard, for the instrumented tests,
     since emulators have no USB MIDI. Off until a test turns it on, which
     is also how the tests unplug and replug it. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <service
            android:name=".TestKeyboardService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_MIDI_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.media.midi.MidiDeviceService" />
            </intent-filter>
            <meta-data
                android:name="android.media.midi.MidiDeviceService"
                android:resource="@xml/test_keyboard" />
        </service>
    </application>
</manifest>
